\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{physiquecours}[2025/09/15 Style compact pour cours]

% ========== PACKAGES ==========
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[french,english]{babel}
\RequirePackage{amsmath, amssymb}
\RequirePackage{siunitx}
\RequirePackage{geometry}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tcolorbox}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}
\RequirePackage{titlesec}

% ========== PAGE LAYOUT ==========
\geometry{margin=2.2cm}   % marges un peu plus serrées
\sisetup{locale = FR, detect-all, separate-uncertainty = true}

% ========== HEADER / FOOTER ==========
\pagestyle{fancy}
\fancyhf{}
\newcommand{\matiere}{Cours} % default subject
\fancyhead[L]{\textsc{\matiere}}
\fancyhead[R]{\textsc{Fiche de cours}}
\fancyfoot[C]{\thepage}
\setlength{\headheight}{15pt}

% ========== COLORS ==========
\definecolor{mainblue}{RGB}{33, 100, 200}
\definecolor{lightgray}{gray}{0.96}
\definecolor{attentionred}{RGB}{190, 30, 30}
\definecolor{remarquegray}{RGB}{100, 100, 100}

% ========== TITLE ==========
\newcommand{\titre}[2]{%
  \begin{center}
    {\LARGE\bfseries #1}\\[0.2cm]
    {\normalsize\itshape #2}
  \end{center}
  \vspace{0.3cm}
  \hrule
  \vspace{0.5em}
}

% ========== CUSTOM BOXES (COMPACTES) ==========
\newtcolorbox{definitionBox}{
  colback=lightgray, colframe=mainblue,
  title=Définition, fonttitle=\bfseries,
  boxrule=0.5mm, arc=1.5mm,
  top=0.5mm, bottom=0.5mm, left=1.5mm, right=1.5mm
}

\newtcolorbox{formuleBox}{
  colback=white, colframe=mainblue,
  title=Formule à retenir, fonttitle=\bfseries,
  boxrule=0.6mm, arc=1mm,
  top=0.5mm, bottom=0.5mm, left=1.5mm, right=1.5mm
}

\newtcolorbox{remarqueBox}{
  colback=lightgray, colframe=remarquegray,
  title=Remarque, fonttitle=\bfseries,
  boxrule=0.4mm, arc=1mm,
  top=0.5mm, bottom=0.5mm, left=1.5mm, right=1.5mm
}

\newtcolorbox{exempleBox}{
  colback=white, colframe=mainblue,
  title=Exemple, fonttitle=\bfseries,
  boxrule=0.5mm, arc=1mm,
  top=0.5mm, bottom=0.5mm, left=1.5mm, right=1.5mm
}

\newtcolorbox{attentionBox}{
  colback=white, colframe=attentionred,
  title=⚠️ Attention, fonttitle=\bfseries,
  boxrule=0.6mm, arc=1mm,
  top=0.5mm, bottom=0.5mm, left=1.5mm, right=1.5mm
}

% ========== COMMAND SHORTCUTS ==========
\newcommand{\definition}[1]{\begin{definitionBox}#1\end{definitionBox}}
\newcommand{\formule}[1]{\begin{formuleBox}#1\end{formuleBox}}
\newcommand{\remarque}[1]{\begin{remarqueBox}#1\end{remarqueBox}}
\newcommand{\exemple}[1]{\begin{exempleBox}#1\end{exempleBox}}
\newcommand{\attention}[1]{\begin{attentionBox}#1\end{attentionBox}}

\newcommand{\illustration}[2]{%
  \begin{center}
    \includegraphics[width=0.45\textwidth]{#1} \\  % plus compact
    \small\textit{#2}
  \end{center}
}

\newcommand{\unite}[1]{\si{#1}}

% ========== SECTION SPACING ==========
\titlespacing*{\section}{0pt}{0.8em}{0.5em}      % Section : marge avant/après
\titlespacing*{\subsection}{0pt}{0.5em}{0.3em}  % Sous-section : marge avant/après
\titlespacing*{\subsubsection}{0pt}{0.3em}{0.2em} % Sous-sous-section

% ========== SECTION NUMBERING ==========
\renewcommand{\thesection}{\Roman{section}}          % I, II, III...
\renewcommand{\thesubsection}{\Alph{subsection}}     % A, B, C...
\renewcommand{\thesubsubsection}{\arabic{subsubsection}} % 1, 2, 3...
\renewcommand{\theparagraph}{\alph{paragraph}}       % a, b, c...

% ========== SECTION FORMATTING ==========
\usepackage{titlesec}

% Sections principales (I, II, III) : gras et légèrement plus grand, numéro décalé
\titleformat{\section}
  {\bfseries\large}         % texte en gras et légèrement plus grand
  {\thesection}{1em}{}       % 1em = espace entre numéro et titre

% Sous-sections (A, B, C) : normal mais avec parenthèses pour distinction
\titleformat{\subsection}
  {\large\bfseries}          % texte en gras mais un peu plus petit que section
  {(\thesubsection)}{0.5em}{}  % affiche (A), (B), ...

% Sous-sous-sections (1, 2, 3) : italique pour distinction
\titleformat{\subsubsection}
  {\normalsize\itshape}      % italique pour les sous-sous-sections
  {\thesubsubsection.}{0.5em}{}

% ========== ENUMERATION PLANS ==========
\newlist{planI}{enumerate}{1}
\setlist[planI]{label=\Roman*., left=0pt, itemindent=1.5em}

\newlist{planA}{enumerate}{1}
\setlist[planA]{label=\Alph*., left=0pt, itemindent=2em}

\newlist{plan1}{enumerate}{1}
\setlist[plan1]{label=\arabic*., left=0pt, itemindent=2.5em}

\newlist{plana}{enumerate}{1}
\setlist[plana]{label=\alph*), left=0pt, itemindent=3em}

\providecommand{\planI}[1]{\begin{planI}#1\end{planI}}
\providecommand{\planA}[1]{\begin{planA}#1\end{planA}}
\providecommand{\planone}[1]{\begin{plan1}#1\end{plan1}}
\providecommand{\planautre}[1]{\begin{plana}#1\end{plana}}

% ========== SIMPLE LISTS ==========
\newenvironment{listeTirets}{\begin{itemize}[label=--]}{\end{itemize}}
\newenvironment{listePoints}{\begin{itemize}[label=•]}{\end{itemize}}

% ========== START DOCUMENT WITH SUBJECT ==========
\newcommand{\startdocument}[1]{%
  \renewcommand{\matiere}{#1}%
  \begin{document}
  \thispagestyle{fancy}
}

\endinput
